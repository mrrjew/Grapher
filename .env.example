# Server-only settings. Never prefix the secret key or limiter secret with NEXT_PUBLIC_.
APP_ORIGIN=http://127.0.0.1:3000
# Set false only for temporary direct signup; match Supabase's Confirm email toggle.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_key
# Generate with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
# Phase 2: Paystack test mode only. Live keys are rejected by the app.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_key
# Optional: new timestamped webhook signing secret from Paystack.
# When set, legacy x-paystack-signature fallback is disabled.
PAYSTACK_WEBHOOK_SECRET=
