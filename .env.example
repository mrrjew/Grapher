# Server-only settings. Never prefix the service key or limiter secret with NEXT_PUBLIC_.
APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Generate with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
